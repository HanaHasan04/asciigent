# Copy to .env and fill in. .env is git-ignored -- never commit a real key.
# Free key from https://aistudio.google.com/apikey
# IMPORTANT: do not enable billing on the Google Cloud project. With billing
# off, exceeding the free tier returns HTTP 429 instead of charging you.
GEMINI_API_KEY=

# Optional alternative free providers.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional: a local vLLM / Ollama server (no key needed).
# ASCIIGENT_LOCAL_URL=http://localhost:8000/v1
